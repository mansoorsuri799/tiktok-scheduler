# Google Analytics 4 measurement ID (optional).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- TikTok Login Kit + Content Posting API ---
# Create an app at https://developers.tiktok.com/
# Add products: Login Kit (Web) + Content Posting API (Direct Post)
# Scopes: user.info.basic, video.upload, video.publish
# Redirect URI (exact): https://tiktokscheduler.net/api/tiktok/callback
# For local: http://localhost:3000/api/tiktok/callback (must also be registered)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://tiktokscheduler.net/api/tiktok/callback

# Sign session cookies (min 16 chars). Generate: openssl rand -hex 32
SESSION_SECRET=

# Protect /api/cron/publish (optional in local dev; required in production)
# Call every minute: curl -H "Authorization: Bearer $CRON_SECRET" https://tiktokscheduler.net/api/cron/publish
CRON_SECRET=

# Optional override for JSON store directory (default: ./data)
# DATA_DIR=/var/lib/tiktok-scheduler
